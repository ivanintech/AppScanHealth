# ==============================================================================
# ScanHealth — Plantilla de variables de entorno
# Copia este fichero a `.env` y rellena tus propios valores.
# NO subas nunca tu `.env` real al repositorio.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase (frontend — prefijo VITE_ para que Vite lo exponga al cliente)
# https://supabase.com/dashboard  →  Project Settings  →  API
# ------------------------------------------------------------------------------
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=https://<TU-PROYECTO>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Compatibilidad con la variante Next.js del cliente
NEXT_PUBLIC_SUPABASE_URL=https://<TU-PROYECTO>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=

# ------------------------------------------------------------------------------
# ⚠️  SOLO SERVIDOR — nunca con prefijo VITE_/NEXT_PUBLIC_ ni en el bundle cliente
# ------------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# APIs externas de datos científicos
# ------------------------------------------------------------------------------
# NHANES — National Health and Nutrition Examination Survey
# https://wwwn.cdc.gov/nchs/nhanes/
NHANES_API_KEY=
NHANES_BASE_URL=https://wwwn.cdc.gov/Nchs/Nhanes/

# ClinicalTrials.gov (ensayos clínicos)
# https://clinicaltrials.gov/data-api/api
CTO_API_KEY=
CTO_BASE_URL=https://api.clinicaltrials.gov/v2/

# DSLD — Dietary Supplement Label Database (NIH)
# https://dsld.od.nih.gov/
DSLD_API_KEY=
DSLD_BASE_URL=https://dsld.nlm.nih.gov/dsld/api/v1/

# ------------------------------------------------------------------------------
# Sincronización y limpieza de datos
# ------------------------------------------------------------------------------
SYNC_INTERVAL_HOURS=24
SYNC_ENABLED=true
CLEANUP_OLD_DATA=true
CLEANUP_DAYS=30

# Límites de ingesta por fuente
MAX_NHANES_RECORDS=10000
MAX_CTO_TRIALS=5000
MAX_DSLD_PRODUCTS=20000

# ------------------------------------------------------------------------------
# IA / Machine Learning
# ------------------------------------------------------------------------------
ML_TRAINING_ENABLED=true
ML_MODEL_UPDATE_INTERVAL_HOURS=168
ML_CONFIDENCE_THRESHOLD=0.7

# ------------------------------------------------------------------------------
# Wearables (sincronización de métricas de salud)
# ------------------------------------------------------------------------------
WEARABLES_SYNC_ENABLED=true
WEARABLES_SYNC_INTERVAL_HOURS=6
